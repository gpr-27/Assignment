# Copy to .env and fill in. Never commit .env.

# Postgres with pgvector. Supabase: Project Settings -> Database -> Connection string (Session pooler).
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (docker compose ignores this and uses its own local database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-in-production

# First admin account, created on startup if missing
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Anthropic — key from https://console.anthropic.com (official API, not a third-party router)
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-20250514

LOG_LEVEL=INFO
